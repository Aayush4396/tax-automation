{
  "bank_key": "sbi",
  "ifsc_prefixes": ["SBIN"],
  "display_name": "State Bank of India",
  "rules_module": null,
  "alias_tokens": ["\\bSBI\\b", "\\bSBIN\\b", "STATE\\s*BANK\\s*OF\\s*INDIA", "STATE\\s*BANK"],
  "rules": [
    {
      "label": "Dividend Income",
      "account_head": "Dividend Income (IFOS)",
      "pattern": "BULK\\s*POSTING[-\\s]*(?:ACHCr|C\\d+)",
      "direction": "CR",
      "confidence": 0.88
    },
    {
      "label": "Bank Interest",
      "account_head": "Interest on Savings A/c (80TTA)",
      "pattern": "CREDIT\\s*INTEREST|INT(?:EREST)?\\s*CREDIT",
      "direction": "CR",
      "confidence": 0.92
    },
    {
      "label": "Life Insurance Premium",
      "account_head": "Deduction u/s 80C - Life Insurance",
      "pattern": "INB\\s*HDFC\\s*LIFE|INB.*INSURANCE|HDFC\\s*LIFE\\s*INSUR|LIC\\s*PREMIUM",
      "direction": "DR",
      "confidence": 0.88
    },
    {
      "label": "PPF Deposit",
      "account_head": "Deduction u/s 80C - PPF",
      "pattern": "SBIYA.*PPF|INB.*PPF|\\bPPF\\b",
      "direction": "DR",
      "confidence": 0.88
    },
    {
      "label": "Auto Sweep FD",
      "account_head": "Auto Sweep FD",
      "pattern": "INB\\s*Deposit|INB\\s*Investment|INB\\s*Dep|Deposit\\s*or\\s*Inv|SBIYA|SWEEP\\s*TRF|MOD\\s*REFUND|AUTO\\s*SWEEP",
      "direction": "DR",
      "confidence": 0.85
    },
    {
      "label": "Bank Charges",
      "account_head": "Bank Charges",
      "pattern": "^CHG:|^CHARGES|SMS\\s*CHG|MIN\\s*BAL\\s*CHG|ANNUAL\\s*MAINT",
      "direction": "DR",
      "confidence": 0.88
    },
    {
      "label": "ATM Withdrawal",
      "account_head": "Cash",
      "pattern": "ATM\\s*WDL|ATM\\s*CASH|CASH\\s*WDL\\s*ATM",
      "direction": "DR",
      "confidence": 0.90
    }
  ],
  "meta_signals": [
