{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Rules Configuration Schema",
  "description": "Schema for transaction classification rules",
  "type": "object",
  "properties": {
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Human-readable label for the rule"
          },
          "head": {
            "type": "string",
            "description": "Account head for the transaction"
          },
          "pattern": {
            "type": "string",
            "description": "Regular expression pattern to match transaction particulars"
          },
          "min_dr": {
            "type": "number",
            "description": "Minimum debit amount for the rule to apply"
          },
          "max_dr": {
            "type": "number",
            "description": "Maximum debit amount for the rule to apply"
          },
          "min_cr": {
            "type": "number",
            "description": "Minimum credit amount for the rule to apply"
          },
          "max_cr": {
            "type": "number",
            "description": "Maximum credit amount for the rule to apply"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Confidence score for the rule (0-1)"
          }
        },
        "required": [
          "label",
          "head",
          "pattern",
          "confidence"
        ]
      }
    }
  },
  "required": [
    "rules"
  ]
}