{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EntityProfileConfig",
  "description": "Declarative configuration schema for an entity / taxpayer profile",
  "type": "object",
  "required": [
    "entity_id",
    "display_name"
  ],
  "properties": {
    "entity_id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Lowercase alphanumeric identifier for the entity"
    },
    "display_name": {
      "type": "string",
      "description": "Full legal name or display name of the taxpayer"
    },
    "pan": {
      "type": "string",
      "description": "Permanent Account Number (optional)"
    },
    "self_patterns": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Regex patterns matching the entity's own name on transfers and UPI"
    },
    "self_vpas": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Personal UPI VPAs or mobile numbers"
    },
    "family_members": {
      "type": "array",
      "description": "Declared family members for automatic transfer classification",
      "items": {
        "type": "object",
        "required": ["name", "patterns", "account_head"],
        "properties": {
          "name": { "type": "string" },
          "relationship": { "type": "string" },
          "patterns": { "type": "array", "items": { "type": "string" } },
          "account_head": { "type": "string" }
        }
      }
    },
    "rent": {
      "type": "object",
      "description": "Rent and landlord classification configuration",
      "properties": {
        "landlords": { "type": "array", "items": { "type": "string" } },
        "vpas": { "type": "array", "items": { "type": "string" } },
        "keywords": { "type": "array", "items": { "type": "string" } }
      }
    },
    "custom_rules": {
      "type": "array",
      "description": "Declarative custom classification rules specific to this entity",
      "items": {
        "type": "object",
        "required": ["label", "account_head"],
        "properties": {
          "label": { "type": "string" },
          "account_head": { "type": "string" },
          "pattern": { "type": "string" },
          "exact_amount": { "type": "number" },
          "direction": { "type": "string", "enum": ["DR", "CR", "dr", "cr", "ANY", "any", "both"] },
          "confidence": { "type": "number" }
        }
      }
    },
    "output_sheet_names": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of sheet names to exclude from statement ingestion"
    },
    "accounts": {
      "type": "array",
      "description": "List of bank and financial accounts belonging to this entity",
      "items": {
        "type": "object",
        "required": ["account_key", "bank", "account_id", "sheet_name"],
        "properties": {
          "account_key": { "type": "string" },
          "bank": { "type": "string" },
          "account_id": { "type": "string" },
          "sheet_name": { "type": "string" },
          "display_name": { "type": "string" },
          "meta_signals_extra": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "banks": {
      "type": "object",
      "description": "Legacy bank mapping dictionary for backward compatibility"
    }
  }
}